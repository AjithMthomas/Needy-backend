# nuvra backend — environment template.
# Copy to backend/.env and adjust. NEVER commit .env.

# ── Django ────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-to-a-50-char-random-string
DEBUG=1
ALLOWED_HOSTS=127.0.0.1,localhost,10.0.2.2,192.168.1.9

# ── Database ──────────────────────────────────────────────
# Dev default is SQLite; set DATABASE_URL for Postgres (Neon/Supabase).
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# ── CORS ──────────────────────────────────────────────────
# Comma-separated origins; dev defaults to allow-all.
# CORS_ALLOWED_ORIGINS=https://nuvra.app,http://localhost:8090

# ── Email OTP (dev logs codes to console) ─────────────────
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.resend.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=resend
# EMAIL_HOST_PASSWORD=your-api-key
# DEFAULT_FROM_EMAIL=nuvra <noreply@nuvra.app>

# ── Tunables ──────────────────────────────────────────────
OTP_VALIDITY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
SERVICE_FEE_PERCENT=5.0
PLAY_DAILY_CONSOLATION_KARMA=10
IDEA_PUBLISH_KARMA=15
